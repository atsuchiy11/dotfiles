[user]
	name = Atsushi Tsuchiya
	email = atsuchiy11@gmail.com
[init]
	defaultBranch = main
[ghq]
	root = ~/.ghq
[core]
	excludesfile = /Users/tsuchiyaatsushishi/.gitignore_global
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	light = false
	side-by-side = false
	line-numbers = true
[merge]
	conflictStyle = diff3
[diff]
	colorMoved = default
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[commit]
	template = /Users/tsuchiyaatsushishi/.stCommitMsg
