# Brewfile — declares CLI tools and GUI apps for `brew bundle`
# Apply with: brew bundle --file=~/.ghq/github.com/atsuchiy11/dotfiles/Brewfile
# Verify with: brew bundle check --file=...

# === dotfiles management ===
brew "chezmoi"

# === Shell prompt & history ===
brew "starship"
brew "atuin"
brew "zoxide"

# === Search / find / fuzzy ===
