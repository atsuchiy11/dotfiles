Include ~/.orbstack/ssh/config

Host github
  HostName github.com
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_ed25519
  User git
  Port 22
  TCPKeepAlive yes
  IdentitiesOnly yes

Host gitlab
  HostName gitlab.com
  IdentityFile ~/.ssh/gitlab
  User git
  Port 22
  TCPKeepAlive yes
  IdentitiesOnly yes
